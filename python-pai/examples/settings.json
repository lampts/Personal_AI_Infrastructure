{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PAI_PYTHON": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pai-hooks start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pai-hooks end"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pai-hooks tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'grep -o \"COMPLETED: .*\" | cut -d: -f2 | xargs pai-voice --silent || true'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "TodoWrite(*)",
      "Task(*)"
    ]
  }
}
